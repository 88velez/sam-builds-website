# Admin Configuration
# ADMIN_PASSWORD is the plain-text password used to sign into the admin panel.
# It is hashed using SHA-256 at runtime (not stored in plain text).
# Choose a strong, unique password (at least 12 characters).
ADMIN_PASSWORD=your-secure-admin-password-here

# Admin email (used for notifications)
ADMIN_EMAIL=admin@yourbusiness.com

# Site URL (used for canonical links, sitemap, etc.)
SITE_URL=https://yourbusiness.com

# Optional: Resend API key for email notifications.
# When set, contact-form submissions are emailed to ADMIN_EMAIL (in addition to
# being saved locally). Leave unset to skip email. Get a free key at https://resend.com.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Optional: verified "from" address for Resend (defaults to onboarding@resend.dev).
# RESEND_FROM=notifications@yourbusiness.com
