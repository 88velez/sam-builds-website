---
import { site } from "../data/site.config";
interface Props {
  heading?: string;
  description?: string;
  primaryCta?: { label: string; href: string };
}
const {
  heading = "Ready to get started?",
  description = "Reach out for a free consultation. We typically respond within one business day.",
  primaryCta = { label: "Contact us", href: "/contact" },
} = Astro.props;
---

<section class="cta-banner">
  <div class="container cta-inner">
    <div>
      <h2>{heading}</h2>
      <p>{description}</p>
    </div>
    <div class="cta-actions">
      <a href={primaryCta.href} class="btn btn-accent">{primaryCta.label}</a>
      <a href={`tel:${site.phone.replace(/\D/g, "")}`} class="btn btn-outline btn-light">
        Call {site.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    background: var(--color-primary);
    color: var(--color-text-inverse);
    padding-block: var(--space-16);
  }
  .cta-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 760px) {
    .cta-inner { grid-template-columns: 2fr 1fr; }
  }
  h2 {
    color: var(--color-text-inverse);
    margin-bottom: var(--space-3);
  }
  p {
    color: rgba(255,255,255,0.85);
    font-size: var(--text-lg);
    max-width: 50ch;
  }
  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .btn-light {
    border-color: rgba(255,255,255,0.5);
    color: var(--color-text-inverse);
  }
  .btn-light:hover {
    background: var(--color-text-inverse);
    color: var(--color-primary);
  }
</style>
