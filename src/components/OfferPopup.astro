---
/**
 * OfferPopup — promotional modal driven by the admin Marketing panel
 * (src/data/marketing.json → `popup`). Rendered by BaseLayout when enabled.
 * Shows after `delayMs` (or on exit intent), then respects `frequencyDays`.
 */
interface PopupData {
  title: string;
  description: string;
  buttonText: string;
  buttonUrl: string;
  imageUrl?: string;
  showOnExit?: boolean;
  delayMs?: number;
  frequencyDays?: number;
}
interface Props {
  popup: PopupData;
}

const { popup } = Astro.props;
const config = {
  showOnExit: popup.showOnExit ?? false,
  delayMs: popup.delayMs ?? 5000,
  frequencyDays: popup.frequencyDays ?? 7,
};
---

<div class="offer-popup" data-config={JSON.stringify(config)} hidden>
  <div class="offer-backdrop" data-close></div>
  <div class="offer-card" role="dialog" aria-modal="true" aria-label={popup.title}>
    <button class="offer-close" type="button" aria-label="Close" data-close>×</button>
    {popup.imageUrl && <img src={popup.imageUrl} alt="" class="offer-image" />}
    <h2 class="offer-title">{popup.title}</h2>
    {popup.description && <p class="offer-desc">{popup.description}</p>}
    <a href={popup.buttonUrl || "/contact"} class="btn btn-accent offer-cta">
      {popup.buttonText || "Learn more"}
    </a>
  </div>
</div>

<style>
  .offer-popup {
    position: fixed;
    inset: 0;
    z-index: 9997;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }
  .offer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    animation: offerFade 250ms var(--ease-out);
  }
  .offer-card {
    position: relative;
    background: var(--color-bg);
    color: var(--color-text);
    max-width: 440px;
    width: 100%;
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-lg);
    text-align: center;
    animation: offerPop 300ms var(--ease-out);
  }
  .offer-close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-4);
    background: none;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .offer-image {
    width: 100%;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-4);
  }
  .offer-title { color: var(--color-primary); margin-bottom: var(--space-3); }
  .offer-desc { color: var(--color-text-muted); margin: 0 auto var(--space-6); }
  .offer-cta { width: 100%; }

  @keyframes offerFade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes offerPop {
    from { opacity: 0; transform: translateY(12px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
</style>

<script>
  (function () {
    const popup = document.querySelector(".offer-popup");
    if (!popup) return;
    const KEY = "offer-popup-seen";
    let cfg = { showOnExit: false, delayMs: 5000, frequencyDays: 7 };
    try { cfg = JSON.parse(popup.getAttribute("data-config") || "{}"); } catch (e) {}

    function recentlySeen() {
      try {
        const last = localStorage.getItem(KEY);
        if (!last) return false;
        const days = (Date.now() - Number(last)) / (1000 * 60 * 60 * 24);
        return days < (cfg.frequencyDays || 7);
      } catch (e) { return false; }
    }

    if (recentlySeen()) { popup.remove(); return; }

    let shown = false;
    function show() {
      if (shown) return;
      shown = true;
      popup.hidden = false;
      try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {}
    }
    function close() {
      popup.hidden = true;
      popup.remove();
    }

    popup.querySelectorAll("[data-close]").forEach((el) =>
      el.addEventListener("click", close)
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !popup.hidden) close();
    });

    if (cfg.delayMs && cfg.delayMs > 0) {
      setTimeout(show, cfg.delayMs);
    }
    if (cfg.showOnExit) {
      document.addEventListener("mouseout", function onExit(e) {
        if (e.clientY <= 0) { show(); document.removeEventListener("mouseout", onExit); }
      });
    }
  })();
</script>
