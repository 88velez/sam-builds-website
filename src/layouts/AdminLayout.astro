---
/**
 * AdminLayout — shell for all admin pages.
 * Provides a sidebar nav and main content area.
 * Does NOT use BaseLayout (no public header/footer).
 */
export type { Props };

import { site } from "../data/site.config";
import "../styles/global.css";

interface NavLink {
  label: string;
  href: string;
  icon: string;
  active?: boolean;
  subLinks?: { label: string; href: string }[];
}

interface Props {
  title: string;
  activePage?: string;
}

const { title, activePage = "" } = Astro.props;

// Determine which section is active
const isBlog = activePage === "blog" || activePage.startsWith("blog");
const isServices = activePage === "services" || activePage.startsWith("services");
const isContent = isBlog || isServices;

const navLinks: NavLink[] = [
  { label: "Dashboard", href: "/admin", icon: "◉", active: activePage === "dashboard" },
  {
    label: "Content",
    href: "/admin/blog",
    icon: "✎",
    active: isContent,
    subLinks: [
      { label: "Blog Posts", href: "/admin/blog" },
      { label: "Services", href: "/admin/services" },
    ],
  },
  { label: "SEO", href: "/admin/seo", icon: "◎", active: activePage === "seo" },
  { label: "Analytics", href: "/admin/analytics", icon: "▤", active: activePage === "analytics" },
  { label: "Leads", href: "/admin/leads", icon: "✉", active: activePage === "leads" || activePage.startsWith("leads") },
  { label: "Marketing", href: "/admin/marketing", icon: "◆", active: activePage === "marketing" },
  { label: "Settings", href: "/admin/settings", icon: "⚙", active: activePage === "settings" },
];

const now = new Date();
const dateString = now.toLocaleDateString("en-US", {
  weekday: "short",
  year: "numeric",
  month: "short",
  day: "numeric",
  hour: "2-digit",
  minute: "2-digit",
});
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {site.name}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="admin-shell">
      <!-- Sidebar -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
          <a href="/admin" class="sidebar-logo">{site.name}</a>
        </div>

        <nav class="sidebar-nav" aria-label="Admin navigation">
          <ul>
            {navLinks.map((link) => (
              <li class:list={["nav-item", { "has-sub": link.subLinks, "active": link.active }]}>
                <a href={link.href} class="nav-link">
                  <span class="nav-icon" aria-hidden="true">{link.icon}</span>
                  <span class="nav-label">{link.label}</span>
                </a>
                {link.subLinks && link.active && (
                  <ul class="sub-nav">
                    {link.subLinks.map((sub) => (
                      <li>
                        <a
                          href={sub.href}
                          class:list={["sub-nav-link", { active: (sub.href.includes("blog") && isBlog) || (sub.href.includes("services") && isServices) }]}
                        >{sub.label}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>

        <div class="sidebar-footer">
          <a href="/" class="sidebar-footer-link" target="_blank" rel="noopener">
            <span aria-hidden="true">↗</span> View Site
          </a>
          <a href="/admin/logout" class="sidebar-footer-link sign-out">
            <span aria-hidden="true">⏻</span> Sign out
          </a>
        </div>
      </aside>

      <!-- Overlay for mobile -->
      <div class="sidebar-overlay" id="sidebar-overlay"></div>

      <!-- Main content -->
      <div class="main-area">
        <header class="topbar">
          <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
            <span></span><span></span><span></span>
          </button>
          <h1 class="page-title">{title}</h1>
          <div class="topbar-right">
            <span class="topbar-date">{dateString}</span>
            <div class="avatar-badge" aria-label="Admin">
              A
            </div>
          </div>
        </header>

        <main class="main-content">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

<style>
  /* Reset */
  *, *::before, *::after { box-sizing: border-box; margin: 0; }

  body {
    font-family: "Inter", system-ui, -apple-system, sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    background: var(--color-bg-alt, #f7f7f5);
    color: var(--color-text, #1a1a1a);
    transition: background var(--duration-base, 250ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
                color var(--duration-base, 250ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .admin-shell {
    display: flex;
    min-height: 100vh;
  }

  /* ================================================================
     SIDEBAR — dark panel with subtle gradient
     ================================================================ */
  .sidebar {
    width: 260px;
    flex-shrink: 0;
    background: linear-gradient(180deg, #0f1419 0%, #0a0e13 100%);
    color: rgba(255, 255, 255, 0.85);
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 200;
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
    border-right: 1px solid rgba(255, 255, 255, 0.04);
  }

  .sidebar-header {
    padding: 1.5rem 1.5rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .sidebar-logo {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
    display: block;
    letter-spacing: -0.02em;
  }

  .sidebar-nav {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem 0.5rem;
  }

  .sidebar-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-item {
    margin-bottom: 1px;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 1rem;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 8px;
    margin: 0 0.25rem;
    transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover {
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.06);
  }

  .nav-item.active > .nav-link {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
    font-weight: 600;
  }

  .nav-icon {
    font-size: 1rem;
    width: 1.5rem;
    text-align: center;
    flex-shrink: 0;
    opacity: 0.7;
  }

  .nav-item.active .nav-icon {
    opacity: 1;
  }

  .sub-nav {
    list-style: none;
    padding: 0.25rem 0 0.25rem 2.75rem !important;
    margin: 0 0 0.25rem !important;
  }

  .sub-nav-link {
    display: block;
    padding: 0.375rem 0;
    color: rgba(255, 255, 255, 0.4);
    text-decoration: none;
    font-size: 0.8125rem;
    border-radius: 6px;
    padding: 0.375rem 0.625rem;
    transition: all 150ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sub-nav-link:hover {
    color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.04);
  }

  .sub-nav-link.active {
    color: var(--color-accent, #d97706);
    font-weight: 600;
  }

  .sidebar-footer {
    padding: 0.5rem 0.5rem 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .sidebar-footer-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    color: rgba(255, 255, 255, 0.4);
    text-decoration: none;
    font-size: 0.8125rem;
    border-radius: 8px;
    margin: 0 0.25rem;
    transition: all 150ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sidebar-footer-link:hover {
    color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.04);
  }

  .sign-out:hover {
    color: #ef4444 !important;
  }

  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 150;
    backdrop-filter: blur(2px);
  }

  /* ================================================================
     MAIN AREA
     ================================================================ */
  .main-area {
    flex: 1;
    margin-left: 260px;
    min-height: 100vh;
    background: var(--color-bg-alt, #f7f7f5);
    transition: background var(--duration-base, 250ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .topbar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 2rem;
    background: var(--color-bg, #ffffff);
    border-bottom: 1px solid var(--color-border, #e5e5e5);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
    background: rgba(255, 255, 255, 0.85);
    transition: background var(--duration-base, 250ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
                border-color var(--duration-base, 250ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }

  @media (prefers-color-scheme: dark) {
    .topbar {
      background: rgba(15, 20, 25, 0.85);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
  }

  .hamburger {
    display: none;
    background: none;
    border: none;
    width: 36px;
    height: 36px;
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    padding: 0;
    border-radius: 8px;
    transition: background 150ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hamburger:hover {
    background: var(--color-bg-alt, #f7f7f5);
  }

  .hamburger span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-text, #1a1a1a);
    border-radius: 2px;
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .page-title {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary, #1a3a5c);
    flex: 1;
    letter-spacing: -0.02em;
    transition: color var(--duration-base, 250ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .topbar-date {
    font-size: 0.8125rem;
    color: var(--color-text-muted, #5a5a5a);
    font-weight: 500;
    padding: 0.25rem 0.75rem;
    background: var(--color-bg-alt, #f7f7f5);
    border-radius: 8px;
    transition: background var(--duration-base, 250ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .avatar-badge {
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    background: linear-gradient(135deg, var(--color-primary, #1a3a5c), var(--color-primary-light, #2d5a8a));
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    box-shadow: 0 2px 8px rgba(26, 58, 92, 0.2);
  }

  .main-content {
    padding: 2rem;
  }

</style>

<style is:global>
  /* ================================================================
     SHARED ADMIN COMPONENTS — used across all admin pages
     Both admin-* prefixed and legacy class names are supported.
     ================================================================ */

  /* ===================== Buttons ===================== */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    transition: all 150ms cubic-bezier(0.16, 1, 0.3, 1);
    line-height: 1.4;
    background: var(--color-bg, #ffffff);
    color: var(--color-text, #1a1a1a);
  }

  .btn:hover {
    border-color: var(--color-primary, #1a3a5c);
    color: var(--color-primary, #1a3a5c);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .btn-sm {
    font-size: 0.8125rem;
    padding: 0.375rem 0.75rem;
  }

  .btn-primary {
    background: var(--color-primary, #1a3a5c);
    color: var(--color-text-inverse, #fff);
    border-color: var(--color-primary, #1a3a5c);
  }

  .btn-primary:hover {
    background: var(--color-primary-light, #2d5a8a);
    border-color: var(--color-primary-light, #2d5a8a);
    color: var(--color-text-inverse, #fff);
  }

  .btn-accent {
    background: var(--color-accent, #d97706);
    color: var(--color-text-inverse, #fff);
    border-color: var(--color-accent, #d97706);
  }

  .btn-accent:hover {
    background: #b85c00;
    border-color: #b85c00;
    color: var(--color-text-inverse, #fff);
  }

  .btn-outline {
    background: transparent;
    color: var(--color-text, #1a1a1a);
  }

  .btn-outline:hover {
    border-color: var(--color-primary, #1a3a5c);
    color: var(--color-primary, #1a3a5c);
  }

  .btn-danger:hover,
  .admin-btn-danger:hover {
    border-color: var(--color-error, #ef4444) !important;
    color: var(--color-error, #ef4444) !important;
    background: rgba(239, 68, 68, 0.04) !important;
  }

  /* ===================== Cards ===================== */
  .admin-card,
  .card {
    background: var(--color-bg, #ffffff);
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 12px;
    padding: 1.5rem;
    transition: box-shadow 200ms cubic-bezier(0.16, 1, 0.3, 1),
                border-color 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .admin-card:hover,
  .card:hover {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  }

  .admin-card-title,
  .card-title {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary, #1a3a5c);
    margin-bottom: 1rem;
  }

  /* ===================== Stat cards (legacy) =====================
     Used in analytics, leads, and other sub-pages.
     The new dashboard uses stat-card-inner / stat-grid-4 instead. */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 700px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 450px) {
    .stats-grid { grid-template-columns: 1fr; }
  }

  .stat-card {
    background: var(--color-bg, #ffffff);
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 12px;
    padding: 1.25rem;
  }

  .stat-card .stat-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted, #5a5a5a);
    margin-bottom: 0.25rem;
  }

  .stat-card .stat-number {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text, #1a1a1a);
  }

  .stat-card.accent,
  .stat-card.accent {
    border-color: var(--color-accent, #d97706);
    background: linear-gradient(135deg, rgba(217,119,6,0.03), transparent);
  }

  /* ===================== Dashboard stat cards ===================== */
  .stat-grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 700px) {
    .stat-grid-4 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 450px) {
    .stat-grid-4 { grid-template-columns: 1fr; }
  }

  .stat-card-inner {
    background: var(--color-bg, #ffffff);
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: all 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stat-card-inner:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    border-color: rgba(26, 58, 92, 0.15);
  }

  .stat-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .stat-icon-blue {
    background: linear-gradient(135deg, rgba(26, 58, 92, 0.12), rgba(26, 58, 92, 0.06));
    color: var(--color-primary, #1a3a5c);
  }

  .stat-icon-green {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(16, 185, 129, 0.06));
    color: var(--color-success, #10b981);
  }

  .stat-icon-purple {
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.12), rgba(124, 58, 237, 0.06));
    color: #7c3aed;
  }

  .stat-icon-orange {
    background: linear-gradient(135deg, rgba(217, 119, 6, 0.12), rgba(217, 119, 6, 0.06));
    color: var(--color-accent, #d97706);
  }

  .stat-body {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .stat-value {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text, #1a1a1a);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.8125rem;
    color: var(--color-text-muted, #5a5a5a);
  }

  .stat-grid-sm {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .stat-card-sm,
  .stat-grid-secondary {
    background: var(--color-bg, #ffffff);
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 10px;
    padding: 1rem;
    text-align: center;
    transition: box-shadow 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .stat-grid-secondary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    background: none;
    border: none;
    padding: 0;
  }

  .stat-card-sm:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.04);
  }

  .stat-label-sm {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted, #5a5a5a);
    margin-bottom: 0.25rem;
  }

  .stat-value-sm {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary, #1a3a5c);
  }

  /* ===================== Tables ===================== */
  .table-wrap {
    background: var(--color-bg, #ffffff);
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 12px;
    overflow: hidden;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
  }

  .data-table th {
    text-align: left;
    padding: 0.75rem 1rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted, #5a5a5a);
    background: var(--color-bg-alt, #f7f7f5);
    border-bottom: 1px solid var(--color-border, #e5e5e5);
  }

  .data-table td {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    border-bottom: 1px solid var(--color-border, #e5e5e5);
    vertical-align: middle;
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  .data-table tbody tr {
    transition: background 150ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .data-table tbody tr:hover {
    background: rgba(26, 58, 92, 0.03);
  }

  /* ===================== Inputs ===================== */
  .admin-input,
  .input {
    font-family: inherit;
    font-size: 0.875rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 8px;
    background: var(--color-bg, #ffffff);
    color: var(--color-text, #1a1a1a);
    transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
    width: 100%;
  }

  .admin-input:focus,
  .input:focus {
    outline: none;
    border-color: var(--color-primary, #1a3a5c);
    box-shadow: 0 0 0 3px rgba(26, 58, 92, 0.1);
  }

  .admin-input-sm,
  .input-sm {
    font-size: 0.8125rem;
    padding: 0.5rem 0.75rem;
  }

  select.input,
  select.admin-input {
    appearance: auto;
  }

  textarea.input,
  textarea.admin-input {
    resize: vertical;
    min-height: 80px;
  }

  textarea.textarea-mono {
