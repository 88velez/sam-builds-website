---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTABanner from "../components/CTABanner.astro";
import Stats from "../components/Stats.astro";
import Process from "../components/Process.astro";
import { site } from "../data/site.config";

const stats = [
  { value: "2024", label: "Year Founded", icon: "📅" },
  { value: "50+", label: "Sites Launched", icon: "🤝" },
  { value: "100%", label: "Local Support", icon: "🏠" },
  { value: "48h", label: "Mockup Delivery", icon: "⚡" },
];

const steps = [
  { 
    title: "1. Let's Talk", 
    description: "We schedule a short phone call or coffee meeting in the Stroudsburg/Scranton area. You tell me what you do, who your clients are, and your business goals.", 
    icon: "💬", 
    duration: "Discovery" 
  },
  { 
    title: "2. The 48h Mockup", 
    description: "Within 48 hours, I build and send you an interactive, custom design of your new homepage. No static images — a real link you can open on your phone.", 
    icon: "⚡", 
    duration: "Preview" 
  },
  { 
    title: "3. Choose & Sign", 
    description: "If you love the direction, we choose an upfront or monthly plan, sign a short plain-language agreement, and proceed to build out the full structure.", 
    icon: "📋", 
    duration: "Agreement" 
  },
  { 
    title: "4. Development & Launch", 
    description: "I write high-converting copy, optimize speed assets, implement local structural SEO schema, connect your domain, and we go live to the public.", 
    icon: "🚀", 
    duration: "Launch" 
  }
];
---

<BaseLayout
  title="About Samuel Velez"
  description="Learn about Samuel Velez, a local web designer and developer in Northeastern PA. Read the philosophy behind the 48-hour free homepage mockup."
>
  <div class="tech-grid">
    <section class="section page-header text-center">
      <div class="container-narrow">
        <p class="eyebrow">Local. Direct. Transparent.</p>
        <h1>About Sam Builds</h1>
        <p class="lead">
          I'm Samuel Velez, a web designer and developer based in Stroudsburg, Pennsylvania. 
          I build custom, high-converting websites for local contractors, restaurants, and shops across NEPA.
        </p>
      </div>
    </section>
  </div>

  <!-- The Story & Philosophy -->
  <section class="section about-philosophy">
    <div class="container-narrow glass-card philosophy-box">
      <h3 class="gradient-title">The "See It Before You Buy" Philosophy</h3>
      <p class="lead-text">
        Most web design agencies operate on a broken model: they show you a fancy PowerPoint, demand a 50% upfront payment, 
        and ask you to wait weeks hoping you like what they build.
      </p>
      <p>
        I think that's backwards. You wouldn't buy a truck without taking it for a test drive, and you shouldn't buy a website 
        without seeing it first. 
      </p>
      <blockquote>
        "That's why I do it differently: I will build a custom interactive preview of your new homepage within 48 hours — completely free — before you commit to spending a single dollar."
      </blockquote>
      <p>
        If you look at the mockup and decide I'm not the right fit, no hard feelings. You walk away with your wallet untouched. 
        It forces me to deliver exceptional quality from the very first interaction and eliminates 100% of the risk for your business.
      </p>
    </div>
  </section>

  <!-- Local Commitment -->
  <section class="section local-commitment section-alt">
    <div class="container">
      <div class="local-grid">
        <div class="local-text">
          <p class="eyebrow">Serving NEPA & The Poconos</p>
          <h3>A local partner who picks up the phone.</h3>
          <p>
            When you hire an out-of-town agency, you become a ticket number in a helpdesk queue. If your website goes down 
            or you need a menu updated before a weekend rush, you are at their mercy.
          </p>
          <p>
            I run a local shop based right here in Northeastern Pennsylvania. I serve businesses in Stroudsburg, Pocono Pines, 
            Scranton, Wilkes-Barre, and surrounding areas. If you have an issue, you call my personal line and a real, local 
            developer answers. We can meet in person at a coffee shop or at your project site.
          </p>
          <ul class="local-bullets">
            <li><strong>No outsourcing</strong> — I design and code every line myself.</li>
            <li><strong>Built for speed</strong> — No bloated code, ensuring search engines rate you high.</li>
            <li><strong>No recurring traps</strong> — If you pay in full, you own your code outright. No string licensing.</li>
          </ul>
        </div>
        <div class="local-card glass-card">
          <h4>Service Areas</h4>
          <p class="area-sub">Proudly designing for local PA brands in:</p>
          <div class="areas-list">
            <span class="area-tag">Stroudsburg & E. Stroudsburg</span>
            <span class="area-tag">Scranton & Wilkes-Barre</span>
            <span class="area-tag">Mount Pocono & Tannersville</span>
            <span class="area-tag">Pocono Pines & Lake Naomi</span>
            <span class="area-tag">Hazleton & Jim Thorpe</span>
            <span class="area-tag">Delaware Water Gap & NEPA</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Stats stats={stats} columns={4} />

  <Process steps={steps} variant="timeline" heading="How We Work Together" description="A highly structured, transparent development roadmap focused on speed and client confidence." />

  <CTABanner heading="Let's build your free homepage preview" description="Tell me about your business today and see a custom design in 48 hours. Zero risk, zero obligation." />
</BaseLayout>

<style>
  .text-center { text-align: center; }
  .gradient-title {
    background: linear-gradient(135deg, var(--color-accent) 0%, #8b5cf6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .page-header {
    padding-block: clamp(var(--space-12), 10vw, var(--space-20));
  }
  .page-header h1 {
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }
  .lead {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    line-height: var(--leading-snug);
  }

  /* Philosophy Box */
  .about-philosophy {
    padding-block: var(--space-8);
  }
  .philosophy-box {
    padding: var(--space-10);
    background: rgba(15, 23, 42, 0.5);
  }
  .lead-text {
    font-size: var(--text-lg);
    color: var(--color-text);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-4);
  }
  .philosophy-box p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }
  .philosophy-box blockquote {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-4);
    margin-block: var(--space-6);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  /* Local Commitment */
  .local-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  .local-text h3 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-4);
  }
  .local-text p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }
  .local-bullets {
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .local-bullets li {
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  .local-bullets li::before {
    content: "⚡";
    color: var(--color-accent);
    margin-right: var(--space-2);
  }

  .local-card {
    padding: var(--space-8);
    background: rgba(15, 23, 42, 0.4);
    border-color: rgba(0, 242, 254, 0.1);
  }
  .local-card h4 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-1);
  }
  .area-sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }
  .areas-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .area-tag {
    font-size: var(--text-xs);
    font-weight: 600;
    background: rgba(0, 242, 254, 0.05);
    border: 1px solid rgba(0, 242, 254, 0.15);
    color: var(--color-accent);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
  }

  @media (max-width: 880px) {
    .local-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
