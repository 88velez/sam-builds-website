---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getBlogPost } from "../../../lib/content-manager";
import { site } from "../../../data/site.config";

const { slug } = Astro.params;
const isNew = slug === "new";

let post = null;
if (!isNew && slug) {
  post = await getBlogPost(slug);
}

// Default values for new post
const defaultTitle = "";
const defaultDescription = "";
const defaultAuthor = site.name;
const defaultPubDate = new Date().toISOString().split("T")[0];
const defaultTags: string[] = [];
const defaultDraft = false;
const defaultBody = "";
---

<AdminLayout title={isNew ? "New Blog Post" : `Edit: ${post?.title || "Blog Post"}`} activePage="blog">
  <div class="editor-header">
    <h1 class="editor-heading">{isNew ? "New Blog Post" : "Edit Blog Post"}</h1>
    {!isNew && post && (
      <a href={`/blog/${slug}/`} target="_blank" rel="noopener" class="btn btn-outline">
        ↗ View on site
      </a>
    )}
  </div>

  <form id="blog-form" class="editor-form">
    <input type="hidden" name="action" value={isNew ? "create" : "update"} />
    {!isNew && <input type="hidden" name="slug" value={slug} />}

    <div class="form-layout">
      <!-- Left column: Editor -->
      <div class="form-main">
        <div class="field">
          <label for="title">Title <span class="required">*</span></label>
          <input id="title" name="title" type="text" class="input" required
            value={post?.title || defaultTitle}
            placeholder="Enter a compelling title" />
        </div>

        <div class="field">
          <label for="slug-field">Slug</label>
          <input id="slug-field" name="slug-field" type="text" class="input input-sm"
            value={post?.slug || ""}
            placeholder="auto-generated from title" />
          <p class="field-hint">Leave empty to auto-generate from title. Must be unique.</p>
        </div>

        <div class="field">
          <label for="description">Meta Description <span class="required">*</span></label>
          <textarea id="description" name="description" class="input textarea" rows="3" required
            maxlength="160"
            placeholder="A brief summary (140–160 characters for SEO)">{post?.description || defaultDescription}</textarea>
          <div class="char-counter" id="desc-counter">0 / 160</div>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="author">Author</label>
            <input id="author" name="author" type="text" class="input"
              value={post?.author || defaultAuthor} />
          </div>
          <div class="field">
            <label for="pubDate">Published Date</label>
            <input id="pubDate" name="pubDate" type="date" class="input"
              value={post ? new Date(post.pubDate).toISOString().split("T")[0] : defaultPubDate} />
          </div>
        </div>

        <div class="field">
          <label for="tags">Tags (comma-separated)</label>
          <input id="tags" name="tags" type="text" class="input"
            value={post?.tags.join(", ") || ""}
            placeholder="e.g. announcements, tips, news" />
          <div class="chips" id="tags-chips">
            {post?.tags.map((t) => (
              <span class="chip">{t} <button type="button" class="chip-remove" aria-label={`Remove ${t}`}>&times;</button></span>
            ))}
          </div>
        </div>

        <div class="field checkbox-field">
          <label class="checkbox-label">
            <input type="checkbox" name="draft" value="true" checked={post?.draft || undefined} />
            <span>Save as draft</span>
          </label>
        </div>

        <div class="field" style="flex:1">
          <label for="body">Content (Markdown) <span class="required">*</span></label>
          <textarea id="body" name="body" class="input textarea textarea-body" rows="20" required
            placeholder="Write your blog post content in Markdown...">{post?.body || defaultBody}</textarea>
        </div>
      </div>

      <!-- Right column: Preview -->
      <div class="form-preview">
        <div class="preview-header">
          <h3 class="preview-title">Preview</h3>
        </div>
        <div class="preview-content" id="preview-content">
          <p class="preview-placeholder">Start typing to see a preview…</p>
        </div>
      </div>
    </div>

    <!-- Toast notification -->
    <div class="toast" id="toast" role="alert" aria-live="polite" hidden></div>

    <div class="form-actions">
      <a href="/admin/blog" class="btn btn-outline">Cancel</a>
      <button type="submit" class="btn btn-accent" id="save-btn">
        {isNew ? "Create Post" : "Save Changes"}
      </button>
    </div>
  </form>
</AdminLayout>

<script>
  (function() {
    const form = document.getElementById("blog-form");
    const toast = document.getElementById("toast");
    const saveBtn = document.getElementById("save-btn");
    const titleInput = document.getElementById("title");
    const slugField = document.getElementById("slug-field");
    const descField = document.getElementById("description");
    const descCounter = document.getElementById("desc-counter");
    const tagsInput = document.getElementById("tags");
    const tagsChips = document.getElementById("tags-chips");
    const bodyField = document.getElementById("body");
    const previewContent = document.getElementById("preview-content");

    // ---- Description character counter ----
    function updateCharCount() {
      const len = descField?.value.length || 0;
      if (descCounter) {
        descCounter.textContent = `${len} / 160`;
        descCounter.style.color = len > 160 ? "var(--color-error, #ef4444)" : "";
      }
    }
    descField?.addEventListener("input", updateCharCount);
    updateCharCount();

    // ---- Auto-generate slug from title ----
    let slugEdited = false;
    slugField?.addEventListener("input", () => { slugEdited = true; });

    titleInput?.addEventListener("input", () => {
      if (!slugEdited && slugField) {
        slugField.value = titleInput.value
          .toLowerCase()
          .replace(/[^a-z0-9\s-]/g, "")
          .replace(/\s+/g, "-")
          .replace(/-+/g, "-")
          .replace(/^-|-$/g, "")
          .slice(0, 60);
      }
    });

    // ---- Tags chips ----
    function renderChips(tags) {
      if (!tagsChips) return;
      tagsChips.innerHTML = tags.map(t =>
        `<span class="chip">${t} <button type="button" class="chip-remove" data-tag="${t}">&times;</button></span>`
      ).join("");

      tagsChips.querySelectorAll(".chip-remove").forEach(btn => {
        btn.addEventListener("click", () => {
          const tag = btn.dataset.tag;
          const current = getTags();
          const filtered = current.filter(t => t !== tag);
          tagsInput.value = filtered.join(", ");
          renderChips(filtered);
        });
      });
    }

    function getTags() {
      return tagsInput?.value.split(",").map(t => t.trim()).filter(Boolean) || [];
    }

    tagsInput?.addEventListener("input", () => {
      renderChips(getTags());
    });

    // ---- Markdown preview ----
    function renderPreview(md) {
      if (!md.trim()) {
        previewContent.innerHTML = '<p class="preview-placeholder">Start typing to see a preview…</p>';
        return;
      }

      // Simple markdown renderer (headers, bold, italic, links, lists, code blocks)
      let html = md
        // Escape HTML
        .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
        // Code blocks
        .replace(/```(\w*)\n([\s\S]*?)```/g, '<pre><code>$2</code></pre>')
        // Inline code
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        // Headers
        .replace(/^### (.+)$/gm, '<h3>$1</h3>')
        .replace(/^## (.+)$/gm, '<h2>$1</h2>')
        .replace(/^# (.+)$/gm, '<h2>$1</h2>')
        // Bold and italic
        .replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>')
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        // Links
        .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
        // Lists
        .replace(/^- (.+)$/gm, '<li>$1</li>')
        // Paragraphs
        .replace(/\n\n/g, '</p><p>')
        .replace(/^(?!<[hpl])/gm, '<p>')
        .replace(/(<\/?p>)\n\n/g, '$1');

      // Wrap consecutive <li> in <ul>
      html = html.replace(/((?:<li>.*?<\/li>\n?)+)/g, '<ul>$1</ul>');

      previewContent.innerHTML = '<div class="preview-rendered">' + html + '</div>';
    }

    bodyField?.addEventListener("input", () => {
      renderPreview(bodyField.value);
    });

    // Initial preview render
    if (bodyField?.value) {
      renderPreview(bodyField.value);
    }

    // ---- Tab support in textarea ----
    bodyField?.addEventListener("keydown", (e) => {
      if (e.key === "Tab") {
        e.preventDefault();
        const start = bodyField.selectionStart;
        const end = bodyField.selectionEnd;
        bodyField.value = bodyField.value.substring(0, start) + "  " + bodyField.value.substring(end);
        bodyField.selectionStart = bodyField.selectionEnd = start + 2;
      }
    });

    // ---- Unsaved changes warning ----
    let formDirty = false;
    form?.addEventListener("change", () => { formDirty = true; });
    bodyField?.addEventListener("input", () => { formDirty = true; });

    window.addEventListener("beforeunload", (e) => {
      if (formDirty) {
        e.preventDefault();
        e.returnValue = "";
      }
    });

    // ---- Form submission ----
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      saveBtn.disabled = true;
      const originalText = saveBtn.textContent;
      saveBtn.textContent = "Saving…";

      const title = document.getElementById("title")?.value || "";
      const description = document.getElementById("description")?.value || "";
      const author = document.getElementById("author")?.value || "";
      const pubDate = document.getElementById("pubDate")?.value || "";
      const tags = getTags();
      const draft = document.querySelector("[name='draft']")?.checked || false;
      const body = bodyField?.value || "";
      const slug = document.getElementById("slug-field")?.value || "";

      // Validation
      const errors = [];
      if (!title.trim()) errors.push("Title is required.");
      if (!description.trim()) errors.push("Description is required.");
      if (description.length > 160) errors.push("Description must be 160 characters or less.");
      if (!body.trim()) errors.push("Content is required.");

      if (errors.length > 0) {
        showToast(errors.join(" "), "error");
        saveBtn.disabled = false;
        saveBtn.textContent = originalText;
        return;
      }

      const action = document.querySelector("[name='action']")?.value || "create";

      try {
        const res = await fetch("/api/admin/blog", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action,
            slug: document.querySelector("[name='slug']")?.value || slug,
            title: title.trim(),
            description: description.trim(),
            author: author.trim(),
            pubDate,
            tags,
            draft,
            body,
          }),
        });

        const data = await res.json();

        if (data.success) {
          formDirty = false;
          showToast("Saved successfully!", "success");
          // If creating, redirect to edit page
          if (action === "create" && data.slug) {
            setTimeout(() => {
              window.location.href = `/admin/blog/${data.slug}`;
            }, 1000);
          }
        } else {
          showToast(data.error || "Save failed.", "error");
        }
      } catch (err) {
        showToast("Network error. Please try again.", "error");
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = originalText;
      }
    });

    // ---- Toast ----
    function showToast(message, type = "info") {
      if (!toast) return;
      toast.textContent = message;
      toast.className = "toast toast-" + type;
      toast.hidden = false;
      setTimeout(() => { toast.hidden = true; }, 5000);
    }
  })();
</script>

<style>
  .editor-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .editor-heading {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary, #1a3a5c);
  }

  .form-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 980px) {
    .form-layout {
      grid-template-columns: 1fr;
    }
    .form-preview {
      order: -1;
      max-height: 300px;
    }
  }

  .form-main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .field label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text, #1a1a1a);
  }

  .required { color: var(--color-error, #ef4444); }

  .input {
    font-family: inherit;
    font-size: 0.875rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 8px;
    background: var(--color-bg, #ffffff);
    color: var(--color-text, #1a1a1a);
    transition: border-color 150ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .input:focus {
    outline: none;
    border-color: var(--color-primary, #1a3a5c);
    box-shadow: 0 0 0 3px rgba(26, 58, 92, 0.1);
  }

  .input-sm { font-size: 0.8125rem; }

  .textarea {
    resize: vertical;
    min-height: 80px;
  }

  .textarea-body {
    font-family: var(--font-mono, "JetBrains Mono", "Courier New", monospace);
    font-size: 0.8125rem;
    line-height: 1.6;
    min-height: 400px;
  }

  .field-hint {
    font-size: 0.75rem;
    color: var(--color-text-muted, #5a5a5a);
  }

  .char-counter {
    font-size: 0.75rem;
    color: var(--color-text-muted, #5a5a5a);
    text-align: right;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 600px) {
    .field-row { grid-template-columns: 1fr; }
  }

  .checkbox-field {
    flex-direction: row;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem !important;
    font-weight: 500 !important;
    cursor: pointer;
  }

  .checkbox-label input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--color-primary, #1a3a5c);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.25rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    background: rgba(26, 58, 92, 0.08);
    color: var(--color-primary, #1a3a5c);
    border-radius: 9999px;
  }

  .chip-remove {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    color: var(--color-primary, #1a3a5c);
    padding: 0;
    opacity: 0.6;
  }

  .chip-remove:hover { opacity: 1; }

  /* ---- Preview pane ---- */
  .form-preview {
    background: var(--color-bg, #ffffff);
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 12px;
    overflow: hidden;
    position: sticky;
    top: 5rem;
    align-self: start;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
  }

  .preview-header {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border, #e5e5e5);
    background: var(--color-bg-alt, #f7f7f5);
  }

  .preview-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted, #5a5a5a);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .preview-content {
    padding: 1rem;
    min-height: 200px;
  }

  .preview-placeholder {
    color: var(--color-text-muted, #5a5a5a);
    font-size: 0.875rem;
    text-align: center;
    padding: 3rem 1rem;
  }

  .preview-rendered {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text, #1a1a1a);
  }

  .preview-rendered h2 {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary, #1a3a5c);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .preview-rendered h3 {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-primary, #1a3a5c);
    margin-top: 1rem;
    margin-bottom: 0.375rem;
  }

  .preview-rendered p { margin-bottom: 0.75rem; }
  .preview-rendered ul { padding-left: 1.25rem; margin-bottom: 0.75rem; }
  .preview-rendered li { margin-bottom: 0.25rem; }
  .preview-rendered pre {
    background: var(--color-bg-dark, #0f1419);
    color: var(--color-text-inverse, #ffffff);
    padding: 0.75rem;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
  }
  .preview-rendered code {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.85em;
  }
  .preview-rendered a { color: var(--color-accent, #d97706); }

  /* ---- Toast ---- */
  .toast {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 500;
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    z-index: 9999;
    animation: slideIn 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes slideIn {
    from { transform: translateY(1rem); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .toast-success {
    background: var(--color-success, #10b981);
    color: white;
  }

  .toast-error {
    background: var(--color-error, #ef4444);
    color: white;
  }

  .toast-info {
    background: var(--color-primary, #1a3a5c);
    color: white;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border, #e5e5e5);
  }
</style>
