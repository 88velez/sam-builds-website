---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { listBlogPosts } from "../../../lib/content-manager";

const posts = await listBlogPosts();

const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
};
---

<AdminLayout title="Blog Posts" activePage="blog">
  <div class="page-header">
    <p class="page-count">{posts.length} {posts.length === 1 ? "post" : "posts"}</p>
    <a href="/admin/blog/new" class="btn btn-primary">+ New Post</a>
  </div>

  <div class="filter-bar">
    <input type="text" id="search-input" class="search-input" placeholder="Search by title or tag…" />
  </div>

  {posts.length === 0 ? (
    <div class="empty-state">
      <div class="empty-icon" aria-hidden="true">✎</div>
      <p class="empty-title">No blog posts yet</p>
      <p class="empty-desc">Create your first blog post to get started.</p>
      <a href="/admin/blog/new" class="btn btn-primary">Write your first post</a>
    </div>
  ) : (
    <div class="table-wrap">
      <table class="data-table" id="posts-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Date</th>
            <th>Tags</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {posts.map((post) => (
            <tr class="post-row" data-search={`${post.title} ${post.tags.join(" ")}`}>
              <td class="cell-title">
                <a href={`/admin/blog/${post.slug}`} class="post-link">{post.title}</a>
              </td>
              <td class="cell-muted">{post.author}</td>
              <td class="cell-muted">{formatDate(post.pubDate)}</td>
              <td>
                {post.tags.length > 0 && (
                  <div class="tags-wrap">
                    {post.tags.map((t) => <span class="tag">{t}</span>)}
                  </div>
                )}
              </td>
              <td>
                <span class:list={["status-badge", post.draft ? "status-draft" : "status-published"]}>
                  {post.draft ? "Draft" : "Published"}
                </span>
              </td>
              <td>
                <div class="action-btns">
                  <a href={`/admin/blog/${post.slug}`} class="btn btn-sm btn-outline">Edit</a>
                  <button class="btn btn-sm btn-outline btn-danger" data-slug={post.slug} data-type="blog" data-action="delete">Delete</button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>

<script>
  // Search/filter
  const searchInput = document.getElementById("search-input");
  if (searchInput) {
    searchInput.addEventListener("input", () => {
      const query = searchInput.value.toLowerCase();
      document.querySelectorAll(".post-row").forEach((row) => {
        const text = row.dataset.search?.toLowerCase() || "";
        row.style.display = text.includes(query) ? "" : "none";
      });
    });
  }

  // Delete handlers
  document.querySelectorAll("[data-action='delete']").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const slug = btn.dataset.slug;
      if (!confirm(`Are you sure you want to delete "${slug}"? This cannot be undone.`)) return;

      btn.disabled = true;
      btn.textContent = "Deleting…";

      try {
        const res = await fetch("/api/admin/blog", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "delete", slug }),
        });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert("Error: " + (data.error || "Delete failed"));
        }
      } catch {
        alert("Network error. Please try again.");
      } finally {
        btn.disabled = false;
        btn.textContent = "Delete";
      }
    });
  });
</script>

<style>
  .post-link {
    color: var(--color-primary, #1a3a5c);
    text-decoration: none;
  }

  .post-link:hover {
    color: var(--color-accent, #d97706);
  }
</style>
