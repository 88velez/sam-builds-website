---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Leads" activePage="leads">
  <!-- Stats -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-label">Total Submissions</div>
      <div class="stat-number" id="total-submissions">—</div>
    </div>
    <div class="stat-card accent">
      <div class="stat-label">Unread</div>
      <div class="stat-number" id="unread-count">—</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">This Week</div>
      <div class="stat-number" id="week-count">—</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Subscribers</div>
      <div class="stat-number" id="subscriber-count">—</div>
    </div>
  </div>

  <!-- Tabs -->
  <div class="tabs" id="leads-tabs">
    <div class="tab-bar">
      <button class="tab-btn active" data-tab="inbox">Inbox</button>
      <button class="tab-btn" data-tab="subscribers">Subscribers</button>
    </div>

    <!-- Inbox tab -->
    <div class="tab-panel active" id="tab-inbox">
      <div id="inbox-list"></div>
    </div>

    <!-- Subscribers tab -->
    <div class="tab-panel" id="tab-subscribers">
      <div id="subscribers-list"></div>
    </div>
  </div>

  <div class="admin-toast" id="toast" role="alert" aria-live="polite" hidden></div>
</AdminLayout>

<script>
  (function() {
    const toast = document.getElementById("toast");

    // Tabs
    document.querySelectorAll(".tab-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
        document.querySelectorAll(".tab-panel").forEach(p => p.classList.remove("active"));
        btn.classList.add("active");
        document.getElementById("tab-" + btn.dataset.tab)?.classList.add("active");
      });
    });

    // Load data
    async function loadData() {
      try {
        const res = await fetch("/api/admin/leads", { method: "GET" });
        const data = await res.json();
        if (data.success) {
          renderStats(data.stats);
          renderInbox(data.submissions);
          renderSubscribers(data.subscribers);
        }
      } catch {
        showToast("Failed to load leads data.", "error");
      }
    }

    function renderStats(stats) {
      document.getElementById("total-submissions").textContent = stats.totalSubmissions;
      document.getElementById("unread-count").textContent = stats.unreadCount;
      document.getElementById("week-count").textContent = stats.submissionsThisWeek;
      document.getElementById("subscriber-count").textContent = stats.totalSubscribers;
    }

    function renderInbox(submissions) {
      const container = document.getElementById("inbox-list");
      if (submissions.length === 0) {
        container.innerHTML = '<div class="empty-state"><p class="empty-note">No submissions yet</p></div>';
        return;
      }

      container.innerHTML = submissions.map(sub => `
        <div class="submission-item ${sub.read ? "read" : "unread"}" data-id="${sub.id}">
          <div class="submission-header">
            <div class="submission-sender">
              <span class="submission-avatar">${sub.name.charAt(0).toUpperCase()}</span>
              <div>
                <strong>${escapeHtml(sub.name)}</strong>
                <span class="submission-email">${escapeHtml(sub.email)}</span>
              </div>
            </div>
            <div class="submission-meta">
              <span class="submission-date">${formatDate(sub.createdAt)}</span>
              <span class="submission-status">${sub.read ? "" : "● Unread"}</span>
            </div>
          </div>
          <div class="submission-subject">${escapeHtml(sub.subject)}</div>
          <div class="submission-message">${escapeHtml(sub.message)}</div>
          <div class="submission-actions">
            ${!sub.read ? `<button class="btn btn-sm btn-outline mark-read" data-id="${sub.id}">Mark Read</button>` : ""}
            <button class="btn btn-sm btn-outline btn-danger delete-submission" data-id="${sub.id}">Delete</button>
          </div>
        </div>
      `).join("");

      // Mark read handlers
      container.querySelectorAll(".mark-read").forEach(btn => {
        btn.addEventListener("click", async () => {
          const id = btn.dataset.id;
          const res = await fetch("/api/admin/leads", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "mark-read", id }),
          });
          const data = await res.json();
          if (data.success) loadData();
        });
      });

      // Delete handlers
      container.querySelectorAll(".delete-submission").forEach(btn => {
        btn.addEventListener("click", async () => {
          if (!confirm("Delete this submission?")) return;
          const id = btn.dataset.id;
          const res = await fetch("/api/admin/leads", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "delete-submission", id }),
          });
          const data = await res.json();
          if (data.success) {
            loadData();
            showToast("Submission deleted.", "info");
          }
        });
      });
    }

    function renderSubscribers(subscribers) {
      const container = document.getElementById("subscribers-list");
      const active = subscribers.filter(s => s.active);
      const inactive = subscribers.filter(s => !s.active);

      if (active.length === 0) {
        container.innerHTML = '<div class="empty-state"><p class="empty-note">No subscribers yet</p></div>';
        return;
      }

      container.innerHTML = `
        <p class="sub-count">${active.length} active subscribers</p>
        <div class="sub-table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Email</th>
                <th>Subscribed</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              ${[...active, ...inactive].map(sub => `
                <tr class="${sub.active ? "" : "inactive-row"}">
                  <td>${escapeHtml(sub.email)}</td>
                  <td class="cell-muted">${formatDate(sub.subscribedAt)}</td>
                  <td>${sub.active ? '<span class="badge-active">Active</span>' : '<span class="badge-inactive">Unsubscribed</span>'}</td>
                  <td>
                    ${sub.active ? `<button class="btn btn-sm btn-outline btn-danger unsubscribe-btn" data-email="${sub.email}">Unsubscribe</button>` : ""}
                  </td>
                </tr>
              `).join("")}
            </tbody>
          </table>
        </div>
      `;

      container.querySelectorAll(".unsubscribe-btn").forEach(btn => {
        btn.addEventListener("click", async () => {
          if (!confirm(`Unsubscribe ${btn.dataset.email}?`)) return;
          const res = await fetch("/api/admin/leads", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "unsubscribe", email: btn.dataset.email }),
          });
          const data = await res.json();
          if (data.success) {
            loadData();
            showToast("Unsubscribed.", "info");
          }
        });
      });
    }

    function formatDate(dateStr) {
      return new Date(dateStr).toLocaleDateString("en-US", {
        year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit"
      });
    }

    function escapeHtml(str) {
      const div = document.createElement("div");
      div.textContent = str;
      return div.innerHTML;
    }

    function showToast(message, type = "info") {
      if (!toast) return;
      toast.textContent = message;
      toast.className = "admin-toast admin-toast-" + type;
      toast.hidden = false;
      setTimeout(() => { toast.hidden = true; }, 4000);
    }

    loadData();
  })();
</script>

<style>
  .stat-card.accent {
    border-color: var(--color-accent, #d97706);
    background: linear-gradient(135deg, rgba(217,119,6,0.03), transparent);
  }

  /* Inbox */
  .submission-item {
    background: var(--color-bg, #ffffff);
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 0.75rem;
    transition: border-color 150ms ease;
  }

  .submission-item.unread {
    border-left: 3px solid var(--color-accent, #d97706);
  }

  .submission-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .submission-sender {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .submission-avatar {
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    background: var(--color-primary, #1a3a5c);
    color: var(--color-text-inverse, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  .submission-sender strong {
    display: block;
    font-size: 0.9375rem;
    color: var(--color-text, #1a1a1a);
  }

  .submission-email {
    font-size: 0.8125rem;
    color: var(--color-text-muted, #5a5a5a);
  }

  .submission-meta {
    text-align: right;
    font-size: 0.75rem;
    color: var(--color-text-muted, #5a5a5a);
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .submission-status {
    color: var(--color-accent, #d97706);
    font-weight: 600;
  }

  .submission-subject {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary, #1a3a5c);
    margin-bottom: 0.5rem;
  }

  .submission-message {
    font-size: 0.875rem;
    color: var(--color-text, #1a1a1a);
    line-height: 1.6;
    margin-bottom: 0.75rem;
    white-space: pre-wrap;
  }

  .submission-actions {
    display: flex;
    gap: 0.5rem;
  }

  /* Subscribers */
  .sub-count {
    font-size: 0.875rem;
    color: var(--color-text-muted, #5a5a5a);
    margin-bottom: 1rem;
  }

  .inactive-row { opacity: 0.5; }
</style>
