---
export const prerender = false;
import { hashPassword, getAdminPassword } from '../../lib/auth';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const password = formData.get('password')?.toString() || '';
  const adminPassword = getAdminPassword();

  if (adminPassword && password === adminPassword) {
    const sessionHash = await hashPassword(adminPassword);
    Astro.cookies.set('admin_session', sessionHash, {
      httpOnly: true,
      sameSite: 'strict',
      path: '/',
      maxAge: 60 * 60 * 24 * 7,
      secure: import.meta.env.PROD,
    });
    const redirect = formData.get('redirect')?.toString() || '/admin';
    return Astro.redirect(redirect, 302);
  }

  return Astro.redirect('/admin/login?error=1', 302);
}

const error = Astro.url.searchParams.get('error');
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign In — Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; }
      html, body { height: 100%; }

      body {
        font-family: "Inter", system-ui, -apple-system, sans-serif;
        font-size: 1rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        background: #0f1419;
        color: rgba(255, 255, 255, 0.85);
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
      }

      .login-container {
        width: 100%;
        max-width: 400px;
        padding: 2rem;
      }

      .login-card {
        background: linear-gradient(180deg, #1a1f26 0%, #151a21 100%);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 16px;
        padding: 2.5rem 2rem;
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
      }

      .login-logo {
        font-family: "Fraunces", Georgia, serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff;
        text-align: center;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
      }

      .login-subtitle {
        text-align: center;
        font-size: 0.875rem;
        color: rgba(255, 255, 255, 0.4);
        margin-bottom: 2rem;
      }

      .login-error {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        border-radius: 10px;
        padding: 0.75rem 1rem;
        font-size: 0.8125rem;
        color: #ef4444;
        margin-bottom: 1.5rem;
        text-align: center;
        animation: fadeIn 300ms ease;
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-0.5rem); }
        to { opacity: 1; transform: translateY(0); }
      }

      .field {
        margin-bottom: 1.25rem;
      }

      .field label {
        display: block;
        font-size: 0.8125rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 0.5rem;
      }

      .field input {
        width: 100%;
        font-family: inherit;
        font-size: 0.9375rem;
        padding: 0.75rem 1rem;
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        color: #fff;
        transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
        outline: none;
      }

      .field input::placeholder {
        color: rgba(255, 255, 255, 0.2);
      }

      .field input:focus {
        border-color: rgba(255, 255, 255, 0.2);
        box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.04);
        background: rgba(0, 0, 0, 0.4);
      }

      .login-btn {
        width: 100%;
        font-family: inherit;
        font-size: 0.9375rem;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        background: linear-gradient(135deg, #d97706, #b85c00);
        color: #fff;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
      }

      .login-btn:hover {
        background: linear-gradient(135deg, #e88a1a, #c96a0a);
        box-shadow: 0 4px 20px rgba(217, 119, 6, 0.3);
        transform: translateY(-1px);
      }

      .login-btn:active {
        transform: translateY(0);
      }

      .login-footer {
        text-align: center;
        margin-top: 1.5rem;
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.2);
      }

      .login-footer a {
        color: rgba(255, 255, 255, 0.3);
        text-decoration: none;
      }

      .login-footer a:hover {
        color: rgba(255, 255, 255, 0.5);
      }
    </style>
  </head>
  <body>
    <div class="login-container">
      <div class="login-card">
        <div class="login-logo">Admin</div>
        <p class="login-subtitle">Sign in to manage your site</p>

        {error && (
          <div class="login-error">Incorrect password. Please try again.</div>
        )}

        <form method="POST">
          <div class="field">
            <label for="password">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              placeholder="Enter admin password"
              autofocus
            />
          </div>
          <button type="submit" class="login-btn">
            Sign In →
          </button>
        </form>

        <div class="login-footer">
          <a href="/">← Back to site</a>
        </div>
      </div>
    </div>
  </body>
</html>
