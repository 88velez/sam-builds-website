---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";

const platforms = [
  { value: "facebook", label: "Facebook" },
  { value: "twitter", label: "X (Twitter)" },
  { value: "instagram", label: "Instagram" },
  { value: "linkedin", label: "LinkedIn" },
  { value: "youtube", label: "YouTube" },
  { value: "tiktok", label: "TikTok" },
  { value: "pinterest", label: "Pinterest" },
  { value: "other", label: "Other" },
];
---

<AdminLayout title="Marketing Tools" activePage="marketing">
  <!-- Tabs -->
  <div class="tabs" id="mkt-tabs">
    <div class="tab-bar">
      <button class="tab-btn active" data-tab="announcement">Announcement Bar</button>
      <button class="tab-btn" data-tab="popup">Offer Popup</button>
      <button class="tab-btn" data-tab="social">Social Links</button>
      <button class="tab-btn" data-tab="calendar">Content Calendar</button>
    </div>

    <!-- Tab: Announcement Bar -->
    <div class="tab-panel active" id="tab-announcement">
      <form id="announcement-form">
        <div class="field checkbox-field">
          <label class="checkbox-label">
            <input type="checkbox" name="enabled" value="true" />
            <span>Enable announcement bar</span>
          </label>
        </div>
        <div class="field">
          <label for="ann-text">Announcement Text <span class="required">*</span></label>
          <input id="ann-text" type="text" class="input" required placeholder="e.g. 🎉 Grand Opening — 20% off all services!" />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="ann-link-url">Link URL (optional)</label>
            <input id="ann-link-url" type="url" class="input" placeholder="https://..." />
          </div>
          <div class="field">
            <label for="ann-link-text">Link Text</label>
            <input id="ann-link-text" type="text" class="input" placeholder="Learn More" />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="ann-bg">Background Color</label>
            <div class="color-wrap">
              <input id="ann-bg" type="color" class="color-input" value="#1a3a5c" />
              <input type="text" class="input input-sm color-text" data-for="ann-bg" />
            </div>
          </div>
          <div class="field">
            <label for="ann-text-color">Text Color</label>
            <div class="color-wrap">
              <input id="ann-text-color" type="color" class="color-input" value="#ffffff" />
              <input type="text" class="input input-sm color-text" data-for="ann-text-color" />
            </div>
          </div>
        </div>
        <div class="field checkbox-field">
          <label class="checkbox-label">
            <input type="checkbox" name="dismissible" value="true" checked />
            <span>Allow visitors to dismiss</span>
          </label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-accent">Save Announcement</button>
        </div>
      </form>
    </div>

    <!-- Tab: Offer Popup -->
    <div class="tab-panel" id="tab-popup">
      <form id="popup-form">
        <div class="field checkbox-field">
          <label class="checkbox-label">
            <input type="checkbox" name="enabled" value="true" />
            <span>Enable offer popup</span>
          </label>
        </div>
        <div class="field">
          <label for="pop-title">Title</label>
          <input id="pop-title" type="text" class="input" placeholder="e.g. Get 20% Off Your First Service!" />
        </div>
        <div class="field">
          <label for="pop-desc">Description</label>
          <textarea id="pop-desc" class="input textarea" rows="3" placeholder="Describe the offer..."></textarea>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="pop-btn-text">Button Text</label>
            <input id="pop-btn-text" type="text" class="input" placeholder="Learn More" />
          </div>
          <div class="field">
            <label for="pop-btn-url">Button URL</label>
            <input id="pop-btn-url" type="url" class="input" placeholder="/contact" />
          </div>
        </div>
        <div class="field">
          <label for="pop-img">Image URL (optional)</label>
          <input id="pop-img" type="text" class="input" placeholder="/images/promo.jpg" />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="pop-delay">Delay (ms)</label>
            <input id="pop-delay" type="number" class="input" value="5000" min="0" step="500" />
          </div>
          <div class="field">
            <label for="pop-frequency">Frequency (days)</label>
            <input id="pop-frequency" type="number" class="input" value="7" min="1" />
          </div>
        </div>
        <div class="field checkbox-field">
          <label class="checkbox-label">
            <input type="checkbox" name="showOnExit" value="true" />
            <span>Show on exit intent</span>
          </label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-accent">Save Offer Popup</button>
        </div>
      </form>
    </div>

    <!-- Tab: Social Links -->
    <div class="tab-panel" id="tab-social">
      <form id="social-form">
        <div class="social-list" id="social-list">
          {platforms.map((p) => (
            <div class="social-item" data-platform={p.value}>
              <div class="social-item-header">
                <span class="social-platform-label">{p.label}</span>
                <label class="toggle-label">
                  <input type="checkbox" class="social-enabled" data-platform={p.value} />
                  <span class="toggle-switch"></span>
                </label>
              </div>
              <div class="social-item-body">
                <div class="field">
                  <label>Profile URL</label>
                  <input type="url" class="input input-sm social-url" data-platform={p.value} placeholder={`https://${p.value}.com/your-profile`} />
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-accent">Save Social Links</button>
        </div>
      </form>
    </div>

    <!-- Tab: Content Calendar -->
    <div class="tab-panel" id="tab-calendar">
      <div class="calendar-header">
        <h3 class="card-title">Scheduled Posts</h3>
        <button class="btn btn-primary" id="show-new-post">+ New Post</button>
      </div>

      <form id="new-post-form" class="new-post-form" style="display:none">
        <div class="field-row">
          <div class="field">
            <label for="post-title">Title <span class="required">*</span></label>
            <input id="post-title" type="text" class="input" required placeholder="Post title" />
          </div>
          <div class="field">
            <label for="post-platform">Platform <span class="required">*</span></label>
            <select id="post-platform" class="input" required>
              <option value="">Select platform…</option>
              {platforms.map(p => <option value={p.value}>{p.label}</option>)}
            </select>
          </div>
        </div>
        <div class="field">
          <label for="post-date">Scheduled Date <span class="required">*</span></label>
          <input id="post-date" type="datetime-local" class="input" required />
        </div>
        <div class="field">
          <label for="post-content">Content</label>
          <textarea id="post-content" class="input textarea" rows="4" placeholder="Post content..."></textarea>
        </div>
        <div class="field">
          <label for="post-link">Link URL</label>
          <input id="post-link" type="url" class="input" placeholder="https://..." />
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-accent">Create Post</button>
          <button type="button" class="btn btn-outline" id="cancel-new-post">Cancel</button>
        </div>
      </form>

      <div id="posts-list"></div>
    </div>
  </div>

  <div class="admin-toast" id="toast" role="alert" aria-live="polite" hidden></div>
</AdminLayout>

<script>
  (function() {
    const toast = document.getElementById("toast");

    // ---- Tabs ----
    document.querySelectorAll(".tab-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
        document.querySelectorAll(".tab-panel").forEach(p => p.classList.remove("active"));
        btn.classList.add("active");
        document.getElementById("tab-" + btn.dataset.tab)?.classList.add("active");
      });
    });

    // ---- Color picker sync ----
    document.querySelectorAll(".color-input").forEach(input => {
      input.addEventListener("input", () => {
        const textInput = document.querySelector(`.color-text[data-for="${input.id}"]`);
        if (textInput) textInput.value = input.value;
      });
      // Initial sync
      const textInput = document.querySelector(`.color-text[data-for="${input.id}"]`);
      if (textInput) textInput.value = input.value;
    });

    document.querySelectorAll(".color-text").forEach(input => {
      input.addEventListener("input", () => {
        const colorId = input.dataset.for;
        const colorInput = document.getElementById(colorId);
        if (colorInput && /^#[0-9a-f]{6}$/i.test(input.value)) {
          colorInput.value = input.value;
        }
      });
    });

    // ---- Load data ----
    async function loadData() {
      try {
        const res = await fetch("/api/admin/marketing", { method: "GET" });
        const data = await res.json();
        if (!data.success) return;

        // Announcement
        const ann = data.data.announcement;
        document.querySelector("[name='enabled']").checked = ann.enabled;
        document.getElementById("ann-text").value = ann.text || "";
        document.getElementById("ann-link-url").value = ann.linkUrl || "";
        document.getElementById("ann-link-text").value = ann.linkText || "";
        document.getElementById("ann-bg").value = ann.backgroundColor || "#1a3a5c";
        document.querySelector(".color-text[data-for=\"ann-bg\"]").value = ann.backgroundColor || "#1a3a5c";
        document.getElementById("ann-text-color").value = ann.textColor || "#ffffff";
        document.querySelector(".color-text[data-for=\"ann-text-color\"]").value = ann.textColor || "#ffffff";
        document.querySelector("[name='dismissible']").checked = ann.dismissible !== false;

        // Popup
        const pop = data.data.popup;
        document.querySelector("#tab-popup [name='enabled']").checked = pop.enabled;
        document.getElementById("pop-title").value = pop.title || "";
        document.getElementById("pop-desc").value = pop.description || "";
        document.getElementById("pop-btn-text").value = pop.buttonText || "Learn More";
        document.getElementById("pop-btn-url").value = pop.buttonUrl || "/contact";
        document.getElementById("pop-img").value = pop.imageUrl || "";
        document.getElementById("pop-delay").value = pop.delayMs || 5000;
        document.getElementById("pop-frequency").value = pop.frequencyDays || 7;
        document.querySelector("[name='showOnExit']").checked = pop.showOnExit || false;

        // Social links
        if (data.data.socialLinks) {
          data.data.socialLinks.forEach(link => {
            const item = document.querySelector(`.social-item[data-platform="${link.platform}"]`);
            if (item) {
              item.querySelector(".social-enabled").checked = link.enabled;
              item.querySelector(".social-url").value = link.url || "";
            }
          });
        }

        // Posts
        renderPosts(data.posts);
      } catch {}
    }

    function renderPosts(posts) {
      const container = document.getElementById("posts-list");
      if (!posts || posts.length === 0) {
        container.innerHTML = '<p class="empty-note">No scheduled posts</p>';
        return;
      }

      const now = new Date();
      const upcoming = posts.filter(p => p.status === "scheduled" || p.status === "draft");
      const past = posts.filter(p => p.status === "published" || p.status === "cancelled");

      container.innerHTML = `
        ${upcoming.length > 0 ? `
          <h4 class="subtitle">Upcoming</h4>
          ${upcoming.map(p => renderPostItem(p)).join("")}
        ` : ""}
        ${past.length > 0 ? `
          <h4 class="subtitle" style="margin-top:1.5rem">Past</h4>
          ${past.map(p => renderPostItem(p)).join("")}
        ` : ""}
      `;

      // Attach event handlers
      container.querySelectorAll(".delete-post").forEach(btn => {
        btn.addEventListener("click", async () => {
          if (!confirm("Delete this post?")) return;
          const res = await fetch("/api/admin/marketing", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "delete-post", id: btn.dataset.id }),
          });
          const data = await res.json();
          if (data.success) { loadData(); showToast("Post deleted.", "info"); }
        });
      });

      container.querySelectorAll(".publish-post").forEach(btn => {
        btn.addEventListener("click", async () => {
          const res = await fetch("/api/admin/marketing", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "update-post", id: btn.dataset.id, updates: { status: "published" } }),
          });
          const data = await res.json();
          if (data.success) { loadData(); showToast("Marked as published.", "success"); }
        });
      });
    }

    function renderPostItem(post) {
      const statusLabels = { draft: "Draft", scheduled: "Scheduled", published: "Published", cancelled: "Cancelled" };
      return `
        <div class="post-item">
          <div class="post-info">
            <strong>${escapeHtml(post.title)}</strong>
            <span class="post-platform">${post.platform}</span>
            <span class="post-date">${new Date(post.scheduledDate).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" })}</span>
          </div>
          <span class="post-status status-${post.status}">${statusLabels[post.status] || post.status}</span>
          <div class="post-actions">
            ${post.status === "scheduled" ? `<button class="btn btn-sm btn-outline publish-post" data-id="${post.id}">Publish</button>` : ""}
            <button class="btn btn-sm btn-outline btn-danger delete-post" data-id="${post.id}">Delete</button>
          </div>
        </div>
      `;
    }

    function escapeHtml(str) {
      const div = document.createElement("div");
      div.textContent = str || "";
      return div.innerHTML;
    }

    // ---- Save Announcement ----
    document.getElementById("announcement-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const announcement = {
        enabled: document.querySelector("#tab-announcement [name='enabled']").checked,
        text: document.getElementById("ann-text").value,
        linkUrl: document.getElementById("ann-link-url").value || undefined,
        linkText: document.getElementById("ann-link-text").value || undefined,
        backgroundColor: document.getElementById("ann-bg").value,
        textColor: document.getElementById("ann-text-color").value,
        dismissible: document.querySelector("[name='dismissible']").checked,
      };
      const res = await fetch("/api/admin/marketing", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "save-announcement", announcement }),
      });
      const data = await res.json();
      showToast(data.success ? "Announcement saved!" : data.error, data.success ? "success" : "error");
    });

    // ---- Save Popup ----
    document.getElementById("popup-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const popup = {
        enabled: document.querySelector("#tab-popup [name='enabled']").checked,
        title: document.getElementById("pop-title").value,
        description: document.getElementById("pop-desc").value,
        buttonText: document.getElementById("pop-btn-text").value || "Learn More",
        buttonUrl: document.getElementById("pop-btn-url").value || "/contact",
        imageUrl: document.getElementById("pop-img").value || undefined,
        showOnExit: document.querySelector("[name='showOnExit']").checked,
        delayMs: parseInt(document.getElementById("pop-delay").value, 10) || 5000,
        frequencyDays: parseInt(document.getElementById("pop-frequency").value, 10) || 7,
      };
      const res = await fetch("/api/admin/marketing", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "save-popup", popup }),
      });
      const data = await res.json();
      showToast(data.success ? "Popup saved!" : data.error, data.success ? "success" : "error");
    });

    // ---- Save Social Links ----
    document.getElementById("social-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const links = Array.from(document.querySelectorAll(".social-item")).map(item => ({
        platform: item.dataset.platform,
        url: item.querySelector(".social-url").value,
        label: item.querySelector(".social-platform-label").textContent,
        enabled: item.querySelector(".social-enabled").checked,
      }));
      const res = await fetch("/api/admin/marketing", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "save-social", links }),
      });
      const data = await res.json();
      showToast(data.success ? "Social links saved!" : data.error, data.success ? "success" : "error");
    });

    // ---- New Post toggle ----
    document.getElementById("show-new-post")?.addEventListener("click", () => {
      document.getElementById("new-post-form").style.display = "block";
    });
    document.getElementById("cancel-new-post")?.addEventListener("click", () => {
      document.getElementById("new-post-form").style.display = "none";
    });

    // ---- Create Post ----
    document.getElementById("new-post-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = e.target.querySelector("[type='submit']");
      btn.disabled = true;
      btn.textContent = "Creating…";

      const post = {
        title: document.getElementById("post-title").value,
        platform: document.getElementById("post-platform").value,
        scheduledDate: new Date(document.getElementById("post-date").value).toISOString(),
        content: document.getElementById("post-content").value,
        linkUrl: document.getElementById("post-link").value || undefined,
        status: "scheduled",
      };

      const res = await fetch("/api/admin/marketing", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "create-post", post }),
      });
      const data = await res.json();

      if (data.success) {
        showToast("Post created!", "success");
        document.getElementById("new-post-form").style.display = "none";
        document.getElementById("new-post-form").reset();
        loadData();
      } else {
        showToast(data.error || "Failed to create.", "error");
      }

      btn.disabled = false;
      btn.textContent = "Create Post";
    });

    // ---- Toast ----
    function showToast(message, type = "info") {
      if (!toast) return;
      toast.textContent = message;
      toast.className = "admin-toast admin-toast-" + type;
      toast.hidden = false;
      setTimeout(() => { toast.hidden = true; }, 4000);
    }

    loadData();
  })();
</script>

<style>
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 600px) { .field-row { grid-template-columns: 1fr; } }

  .color-wrap { display: flex; gap: 0.5rem; align-items: center; }
  .color-input { width: 44px; height: 38px; padding: 0; border: 1px solid var(--color-border, #e5e5e5); border-radius: 8px; cursor: pointer; }
  .color-text { flex: 1; }

  /* Social links */
  .social-list { display: flex; flex-direction: column; gap: 0.75rem; }

  .social-item {
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 10px;
    overflow: hidden;
  }

  .social-item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--color-bg-alt, #f7f7f5);
  }

  .social-platform-label { font-size: 0.875rem; font-weight: 500; color: var(--color-text, #1a1a1a); }

  .toggle-label { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; }
  .toggle-switch {
    width: 40px;
    height: 22px;
    background: var(--color-border, #e5e5e5);
    border-radius: 9999px;
    position: relative;
    transition: background 150ms ease;
  }

  .toggle-switch::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    background: white;
    border-radius: 9999px;
    transition: transform 150ms ease;
  }

  .social-enabled:checked + .toggle-switch {
    background: var(--color-primary, #1a3a5c);
  }

  .social-enabled:checked + .toggle-switch::after {
    transform: translateX(18px);
  }

  .social-enabled { display: none; }

  .social-item-body { padding: 0.75rem 1rem; display: none; }
  .social-enabled:checked ~ .social-item-body { display: block; }

  /* Calendar */
  .calendar-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
  .card-title { font-family: "Fraunces", Georgia, serif; font-size: 1rem; font-weight: 600; color: var(--color-primary, #1a3a5c); margin: 0; }

  .new-post-form {
    background: var(--color-bg-alt, #f7f7f5);
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .post-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-border, #e5e5e5);
  }

  .post-item:last-child { border-bottom: none; }

  .post-info { flex: 1; }
  .post-info strong { display: block; font-size: 0.875rem; color: var(--color-text, #1a1a1a); }
  .post-platform { font-size: 0.75rem; color: var(--color-text-muted, #5a5a5a); margin-right: 0.5rem; }
  .post-date { font-size: 0.75rem; color: var(--color-text-muted, #5a5a5a); }

  .post-status {
    padding: 0.1875rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    border-radius: 9999px;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .status-draft { background: rgba(100,100,100,0.1); color: var(--color-text-muted, #5a5a5a); }
  .status-scheduled { background: rgba(26,58,92,0.1); color: var(--color-primary, #1a3a5c); }
  .status-published { background: rgba(16,185,129,0.1); color: var(--color-success, #10b981); }
  .status-cancelled { background: rgba(239,68,68,0.1); color: var(--color-error, #ef4444); }

  .post-actions { display: flex; gap: 0.375rem; flex-shrink: 0; }

  .subtitle { font-size: 0.8125rem; font-weight: 600; color: var(--color-text-muted, #5a5a5a); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .empty-note { text-align: center; padding: 2rem; color: var(--color-text-muted, #5a5a5a); font-size: 0.875rem; }

  /* Toast */
  .toast {
    position: fixed; bottom: 1.5rem; right: 1.5rem; padding: 0.75rem 1.25rem;
    border-radius: 10px; font-size: 0.875rem; font-weight: 500;
    box-shadow: 0 4px 16px rgba(0,0,0,0.12); z-index: 9999;
    animation: slideIn 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes slideIn { from { transform: translateY(1rem); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  .toast-success { background: var(--color-success, #10b981); color: white; }
  .toast-error { background: var(--color-error, #ef4444); color: white; }
  .toast-info { background: var(--color-primary, #1a3a5c); color: white; }
</style>
