---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getService } from "../../../lib/content-manager";

const { slug } = Astro.params;
const isNew = slug === "new";

let service = null;
if (!isNew && slug) {
  service = await getService(slug);
}
---

<AdminLayout title={isNew ? "New Service" : `Edit: ${service?.title || "Service"}`} activePage="services">
  <div class="editor-header">
    <h1 class="editor-heading">{isNew ? "New Service" : "Edit Service"}</h1>
    {!isNew && service && (
      <a href={`/services/${slug}/`} target="_blank" rel="noopener" class="btn btn-outline">
        ↗ View on site
      </a>
    )}
  </div>

  <form id="service-form" class="editor-form">
    <input type="hidden" name="action" value={isNew ? "create" : "update"} />
    {!isNew && <input type="hidden" name="slug" value={slug} />}

    <div class="form-layout">
      <!-- Left: Editor -->
      <div class="form-main">
        <div class="field">
          <label for="title">Title <span class="required">*</span></label>
          <input id="title" name="title" type="text" class="input" required
            value={service?.title || ""}
            placeholder="e.g. Kitchen Remodeling" />
        </div>

        <div class="field">
          <label for="slug-field">Slug</label>
          <input id="slug-field" name="slug-field" type="text" class="input input-sm"
            value={service?.slug || ""}
            placeholder="auto-generated from title" />
        </div>

        <div class="field">
          <label for="description">Description <span class="required">*</span></label>
          <textarea id="description" name="description" class="input textarea" rows="3" required
            maxlength="160"
            placeholder="Brief service description (140–160 characters for SEO)">{service?.description || ""}</textarea>
          <div class="char-counter" id="desc-counter">0 / 160</div>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="price">Price</label>
            <input id="price" name="price" type="text" class="input"
              value={service?.price || ""}
              placeholder="e.g. Starting at $500" />
          </div>
          <div class="field">
            <label for="duration">Duration</label>
            <input id="duration" name="duration" type="text" class="input"
              value={service?.duration || ""}
              placeholder="e.g. 2–3 hours" />
          </div>
        </div>

        <div class="field checkbox-field">
          <label class="checkbox-label">
            <input type="checkbox" name="featured" value="true" checked={service?.featured || undefined} />
            <span>Featured service</span>
          </label>
        </div>

        <div class="field" style="flex:1">
          <label for="body">Content (Markdown) <span class="required">*</span></label>
          <textarea id="body" name="body" class="input textarea textarea-body" rows="20" required
            placeholder="Describe what this service includes, who it's for, and the process...">{service?.body || ""}</textarea>
        </div>
      </div>

      <!-- Right: Preview -->
      <div class="form-preview">
        <div class="preview-header">
          <h3 class="preview-title">Preview</h3>
        </div>
        <div class="preview-content" id="preview-content">
          <p class="preview-placeholder">Start typing to see a preview…</p>
        </div>
      </div>
    </div>

    <div class="toast" id="toast" role="alert" aria-live="polite" hidden></div>

    <div class="form-actions">
      <a href="/admin/services" class="btn btn-outline">Cancel</a>
      <button type="submit" class="btn btn-accent" id="save-btn">
        {isNew ? "Create Service" : "Save Changes"}
      </button>
    </div>
  </form>
</AdminLayout>

<script>
  (function() {
    const form = document.getElementById("service-form");
    const toast = document.getElementById("toast");
    const saveBtn = document.getElementById("save-btn");
    const titleInput = document.getElementById("title");
    const slugField = document.getElementById("slug-field");
    const descField = document.getElementById("description");
    const descCounter = document.getElementById("desc-counter");
    const bodyField = document.getElementById("body");
    const previewContent = document.getElementById("preview-content");

    // Char counter
    function updateCharCount() {
      const len = descField?.value.length || 0;
      if (descCounter) {
        descCounter.textContent = `${len} / 160`;
        descCounter.style.color = len > 160 ? "var(--color-error, #ef4444)" : "";
      }
    }
    descField?.addEventListener("input", updateCharCount);
    updateCharCount();

    // Auto slug
    let slugEdited = false;
    slugField?.addEventListener("input", () => { slugEdited = true; });

    titleInput?.addEventListener("input", () => {
      if (!slugEdited && slugField) {
        slugField.value = titleInput.value
          .toLowerCase()
          .replace(/[^a-z0-9\s-]/g, "")
          .replace(/\s+/g, "-")
          .replace(/-+/g, "-")
          .replace(/^-|-$/g, "")
          .slice(0, 60);
      }
    });

    // Markdown preview
    function renderPreview(md) {
      if (!md.trim()) {
        previewContent.innerHTML = '<p class="preview-placeholder">Start typing to see a preview…</p>';
        return;
      }

      let html = md
        .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
        .replace(/```(\w*)\n([\s\S]*?)```/g, '<pre><code>$2</code></pre>')
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        .replace(/^### (.+)$/gm, '<h3>$1</h3>')
        .replace(/^## (.+)$/gm, '<h2>$1</h2>')
        .replace(/^# (.+)$/gm, '<h2>$1</h2>')
        .replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>')
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
        .replace(/^- (.+)$/gm, '<li>$1</li>')
        .replace(/\n\n/g, '</p><p>')
        .replace(/^(?!<[hpl])/gm, '<p>')
        .replace(/(<\/?p>)\n\n/g, '$1');

      html = html.replace(/((?:<li>.*?<\/li>\n?)+)/g, '<ul>$1</ul>');
      previewContent.innerHTML = '<div class="preview-rendered">' + html + '</div>';
    }

    bodyField?.addEventListener("input", () => renderPreview(bodyField.value));
    if (bodyField?.value) renderPreview(bodyField.value);

    // Tab support
    bodyField?.addEventListener("keydown", (e) => {
      if (e.key === "Tab") {
        e.preventDefault();
        const start = bodyField.selectionStart;
        const end = bodyField.selectionEnd;
        bodyField.value = bodyField.value.substring(0, start) + "  " + bodyField.value.substring(end);
        bodyField.selectionStart = bodyField.selectionEnd = start + 2;
      }
    });

    // Unsaved warning
    let formDirty = false;
    form?.addEventListener("change", () => { formDirty = true; });
    bodyField?.addEventListener("input", () => { formDirty = true; });

    window.addEventListener("beforeunload", (e) => {
      if (formDirty) { e.preventDefault(); e.returnValue = ""; }
    });

    // Submit
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      saveBtn.disabled = true;
      const originalText = saveBtn.textContent;
      saveBtn.textContent = "Saving…";

      const title = document.getElementById("title")?.value || "";
      const description = document.getElementById("description")?.value || "";
      const price = document.getElementById("price")?.value || "";
      const duration = document.getElementById("duration")?.value || "";
      const featured = document.querySelector("[name='featured']")?.checked || false;
      const body = bodyField?.value || "";
      const slug = document.getElementById("slug-field")?.value || "";

      const errors = [];
      if (!title.trim()) errors.push("Title is required.");
      if (!description.trim()) errors.push("Description is required.");
      if (description.length > 160) errors.push("Description must be 160 characters or less.");
      if (!body.trim()) errors.push("Content is required.");

      if (errors.length > 0) {
        showToast(errors.join(" "), "error");
        saveBtn.disabled = false;
        saveBtn.textContent = originalText;
        return;
      }

      const action = document.querySelector("[name='action']")?.value || "create";

      try {
        const res = await fetch("/api/admin/services", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action,
            slug: document.querySelector("[name='slug']")?.value || slug,
            title: title.trim(),
            description: description.trim(),
            price: price.trim(),
            duration: duration.trim(),
            featured,
            body,
          }),
        });

        const data = await res.json();

        if (data.success) {
          formDirty = false;
          showToast("Saved successfully!", "success");
          if (action === "create" && data.slug) {
            setTimeout(() => { window.location.href = `/admin/services/${data.slug}`; }, 1000);
          }
        } else {
          showToast(data.error || "Save failed.", "error");
        }
      } catch {
        showToast("Network error. Please try again.", "error");
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = originalText;
      }
    });

    function showToast(message, type = "info") {
      if (!toast) return;
      toast.textContent = message;
      toast.className = "toast toast-" + type;
      toast.hidden = false;
      setTimeout(() => { toast.hidden = true; }, 5000);
    }
  })();
</script>

<style>
  .editor-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
  .editor-heading { font-family: "Fraunces", Georgia, serif; font-size: 1.25rem; font-weight: 600; color: var(--color-primary, #1a3a5c); }

  .form-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  @media (max-width: 980px) {
    .form-layout { grid-template-columns: 1fr; }
    .form-preview { order: -1; max-height: 300px; }
  }

  .form-main { display: flex; flex-direction: column; gap: 1rem; }
  .field { display: flex; flex-direction: column; gap: 0.375rem; }
  .field label { font-size: 0.8125rem; font-weight: 600; color: var(--color-text, #1a1a1a); }
  .required { color: var(--color-error, #ef4444); }

  .input {
    font-family: inherit; font-size: 0.875rem; padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-border, #e5e5e5); border-radius: 8px;
    background: var(--color-bg, #ffffff); color: var(--color-text, #1a1a1a);
    transition: border-color 150ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .input:focus { outline: none; border-color: var(--color-primary, #1a3a5c); box-shadow: 0 0 0 3px rgba(26, 58, 92, 0.1); }
  .input-sm { font-size: 0.8125rem; }
  .textarea { resize: vertical; min-height: 80px; }
  .textarea-body { font-family: var(--font-mono, "JetBrains Mono", monospace); font-size: 0.8125rem; line-height: 1.6; min-height: 400px; }

  .char-counter { font-size: 0.75rem; color: var(--color-text-muted, #5a5a5a); text-align: right; }

  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 600px) { .field-row { grid-template-columns: 1fr; } }

  .checkbox-field { flex-direction: row; }
  .checkbox-label { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem !important; font-weight: 500 !important; cursor: pointer; }
  .checkbox-label input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--color-primary, #1a3a5c); }

  .form-preview {
    background: var(--color-bg, #ffffff); border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 12px; overflow: hidden; position: sticky; top: 5rem;
    align-self: start; max-height: calc(100vh - 8rem); overflow-y: auto;
  }
  .preview-header { padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-border, #e5e5e5); background: var(--color-bg-alt, #f7f7f5); }
  .preview-title { font-size: 0.8125rem; font-weight: 600; color: var(--color-text-muted, #5a5a5a); text-transform: uppercase; letter-spacing: 0.05em; }
  .preview-content { padding: 1rem; min-height: 200px; }
  .preview-placeholder { color: var(--color-text-muted, #5a5a5a); font-size: 0.875rem; text-align: center; padding: 3rem 1rem; }
  .preview-rendered { font-size: 0.9375rem; line-height: 1.7; color: var(--color-text, #1a1a1a); }
  .preview-rendered h2 { font-family: "Fraunces", Georgia, serif; font-size: 1.25rem; font-weight: 600; color: var(--color-primary, #1a3a5c); margin-top: 1.5rem; margin-bottom: 0.5rem; }
  .preview-rendered h3 { font-family: "Fraunces", Georgia, serif; font-size: 1.0625rem; font-weight: 600; color: var(--color-primary, #1a3a5c); margin-top: 1rem; margin-bottom: 0.375rem; }
  .preview-rendered p { margin-bottom: 0.75rem; }
  .preview-rendered ul { padding-left: 1.25rem; margin-bottom: 0.75rem; }
  .preview-rendered li { margin-bottom: 0.25rem; }
  .preview-rendered pre { background: var(--color-bg-dark, #0f1419); color: var(--color-text-inverse, #ffffff); padding: 0.75rem; border-radius: 8px; overflow-x: auto; margin-bottom: 0.75rem; font-size: 0.8125rem; }
  .preview-rendered code { font-family: var(--font-mono, "JetBrains Mono", monospace); font-size: 0.85em; }
  .preview-rendered a { color: var(--color-accent, #d97706); }

  .toast {
    position: fixed; bottom: 1.5rem; right: 1.5rem; padding: 0.75rem 1.25rem;
    border-radius: 10px; font-size: 0.875rem; font-weight: 500;
    box-shadow: 0 4px 16px rgba(0,0,0,0.12); z-index: 9999;
    animation: slideIn 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes slideIn { from { transform: translateY(1rem); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  .toast-success { background: var(--color-success, #10b981); color: white; }
  .toast-error { background: var(--color-error, #ef4444); color: white; }
  .toast-info { background: var(--color-primary, #1a3a5c); color: white; }

  .form-actions { display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border, #e5e5e5); }
</style>
