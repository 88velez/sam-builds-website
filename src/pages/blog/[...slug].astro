---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import Newsletter from "../../components/Newsletter.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { getCollection } from "astro:content";

// On-demand: resolve the post by slug at request time (server output).
const { slug } = Astro.params;
const post = (await getCollection("blog", ({ data }) => !data.draft)).find(
  (p) => p.slug === slug
);
if (!post) {
  return Astro.redirect("/blog", 302);
}
const { Content } = await post.render();

const allPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((p) => ({
    slug: p.slug,
    title: p.data.title,
    description: p.data.description,
    pubDate: p.data.pubDate,
    tags: p.data.tags,
  }));

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

// Extract headings for TOC (works with markdown rendered content)
// We build TOC items manually after rendering
const tocItems: { id: string; text: string; level: number }[] = [];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  article={true}
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
>
  <article class="section">
    <div class="container-narrow">
      <header class="post-header">
        <Breadcrumbs crumbs={[
          { label: "Home", href: "/" },
          { label: "Blog", href: "/blog" },
          { label: post.data.title },
        ]} />
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <span>By {post.data.author}</span>
          <span aria-hidden="true">•</span>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          {post.data.updatedDate && (
            <>
              <span aria-hidden="true">•</span>
              <span>Updated {formatDate(post.data.updatedDate)}</span>
            </>
          )}
        </div>
        {post.data.tags.length > 0 && (
          <ul class="tags">
            {post.data.tags.map((t) => <li>{t}</li>)}
          </ul>
        )}
      </header>

      <div class="post-body" id="post-content">
        <Content />
      </div>

      <ShareButtons title={post.data.title} description={post.data.description} />
    </div>
  </article>

  <section class="section">
    <div class="container-narrow">
      <RelatedPosts
        posts={allPosts}
        currentSlug={post.slug}
        currentTags={post.data.tags}
      />
    </div>
  </section>

  <Newsletter />
</BaseLayout>

<style>
  .post-header h1 {
    color: var(--color-primary);
    margin-bottom: var(--space-4);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }
  .tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-12);
  }
  .tags li {
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }
  .post-body :global(h2) {
    color: var(--color-primary);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }
  .post-body :global(h3) {
    color: var(--color-primary);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }
  .post-body :global(p),
  .post-body :global(ul),
  .post-body :global(ol),
  .post-body :global(blockquote) {
    margin-bottom: var(--space-4);
    line-height: var(--leading-loose);
  }
  .post-body :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-4);
    font-style: italic;
    color: var(--color-text-muted);
  }
  .post-body :global(img) {
    border-radius: var(--radius-lg);
    margin-block: var(--space-8);
  }
  .post-body :global(pre) {
    background: var(--color-bg-dark);
    color: var(--color-text-inverse);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-block: var(--space-6);
  }
  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>

<script>
  // Auto-generate TOC from post content headings
  (function() {
    const content = document.getElementById("post-content");
    if (!content) return;
    const headings = content.querySelectorAll("h2, h3");
    if (headings.length < 2) return;
    
    // Add IDs to headings that don't have them
    headings.forEach((h) => {
      if (!h.id) {
        h.id = h.textContent?.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "") || `heading-${Math.random().toString(36).slice(2)}`;
      }
    });

    // Build and insert TOC at the top of post-body
    const toc = document.createElement("nav");
    toc.className = "auto-toc";
    toc.setAttribute("aria-label", "Table of contents");
    
    let html = '<h4 class="auto-toc-heading">On this page</h4><ul class="auto-toc-list">';
    headings.forEach((h) => {
      const level = h.tagName === "H3" ? 3 : 2;
      html += `<li style="padding-left: ${(level - 2) * 1.25}rem"><a href="#${h.id}">${h.textContent}</a></li>`;
    });
    html += "</ul>";
    toc.innerHTML = html;
    content.prepend(toc);

    // Active heading tracking
    const links = toc.querySelectorAll("a");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            links.forEach((l) => l.classList.remove("active"));
            const activeLink = toc.querySelector(`a[href="#${entry.target.id}"]`);
            activeLink?.classList.add("active");
          }
        });
      },
      { rootMargin: "-80px 0px -70% 0px" }
    );
    headings.forEach((h) => observer.observe(h));
  })();
</script>

<style>
  .auto-toc {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
  }
  .auto-toc-heading {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }
  .auto-toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .auto-toc-list a {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
    display: block;
    padding: var(--space-1) 0;
  }
  .auto-toc-list a:hover { color: var(--color-accent); }
  .auto-toc-list a.active { color: var(--color-primary); font-weight: 600; }
</style>
