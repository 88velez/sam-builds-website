---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site.config";
---

<BaseLayout
  title="Contact Samuel Velez"
  description={`Get in touch with ${site.name} to claim your free 48-hour homepage mockup, ask a question, or get a custom quote. Call ${site.phoneDisplay}.`}
>
  <div class="tech-grid">
    <section class="section contact-page">
      <div class="container">
        <div class="contact-grid">
          
          <!-- Contact Copy -->
          <div class="contact-info-panel">
            <p class="eyebrow">Risk-Free Opportunity</p>
            <h1>Let's build a website that brings you customers.</h1>
            <p class="lead">
              Fill out the form to request your free 48-hour homepage preview. You'll receive a real, 
              interactive website link before you spend a single dollar.
            </p>

            <ul class="contact-list">
              <li class="contact-item glass-card">
                <div class="contact-icon">📞</div>
                <div class="contact-text">
                  <strong>Call Personal Line</strong>
                  <a href={`tel:${site.phone.replace(/\D/g, "")}`}>{site.phoneDisplay}</a>
                </div>
              </li>
              
              <li class="contact-item glass-card">
                <div class="contact-icon">📧</div>
                <div class="contact-text">
                  <strong>Direct Email</strong>
                  <a href={`mailto:${site.email}`}>{site.email}</a>
                </div>
              </li>

              <li class="contact-item glass-card">
                <div class="contact-icon">🏠</div>
                <div class="contact-text">
                  <strong>Service Areas</strong>
                  <span>{site.serviceAreas.join(", ")} (PA)</span>
                </div>
              </li>
            </ul>
          </div>

          <!-- Contact Form -->
          <div class="contact-form-panel">
            <ContactForm heading="Claim Your Free 48-Hour Preview" />
          </div>

        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-page {
    padding-block: clamp(var(--space-12), 10vw, var(--space-20));
  }
  
  .contact-grid {
    display: grid;
    gap: var(--space-12);
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 880px) {
    .contact-grid { grid-template-columns: 1fr 1.1fr; }
  }

  .eyebrow {
    color: var(--color-accent);
    font-weight: 600;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: var(--space-3);
  }
  h1 { 
    color: var(--color-text); 
    margin-bottom: var(--space-4);
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
  }
  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
    line-height: var(--leading-normal);
  }

  /* Contact Cards List */
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .contact-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    background: rgba(15, 23, 42, 0.4);
    border-color: rgba(255, 255, 255, 0.05);
  }
  .contact-item:hover {
    border-color: rgba(0, 242, 254, 0.2);
  }
  .contact-icon {
    font-size: var(--text-2xl);
  }
  .contact-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .contact-text strong {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .contact-text a {
    color: var(--color-accent);
    font-weight: 600;
    font-size: var(--text-base);
  }
  .contact-text span {
    font-size: var(--text-sm);
    color: var(--color-text);
  }
</style>
