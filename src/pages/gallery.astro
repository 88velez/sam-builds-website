---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedWebsites from "../components/FeaturedWebsites.astro";

// To swap in real screenshots: drop a PNG in /public/portfolio/ and update the image path below.
const sites = [
  {
    title: "PA Pioneers",
    description: "Bold, high-performance site built for a local Pennsylvania organization — fast load times, mobile-first layout, and clear calls-to-action.",
    url: "https://pa-pioneers.vercel.app",
    image: "https://placehold.co/800x500/020617/00f2fe?text=PA+Pioneers",
    alt: "PA Pioneers website",
    category: "Local Business",
  },
  {
    title: "Finch Hill Restaurant",
    description: "Elegant restaurant site with a digital menu, atmosphere gallery, and reservation-ready contact flow optimized for mobile diners.",
    url: "https://finch-hill-restaurant.vercel.app",
    image: "https://placehold.co/800x500/020617/8b5cf6?text=Finch+Hill+Restaurant",
    alt: "Finch Hill Restaurant website",
    category: "Restaurant",
  },
  {
    title: "Savvy Shoppers",
    description: "Retail-focused storefront site with product highlights, promotional sections, and a streamlined path from browse to contact.",
    url: "https://savvy-shoppers.vercel.app",
    image: "https://placehold.co/800x500/020617/f59e0b?text=Savvy+Shoppers",
    alt: "Savvy Shoppers website",
    category: "Retail",
  },
  {
    title: "Mike's Auto Detailing",
    description: "Click-to-call booking, before/after gallery, and local SEO setup for a mobile auto detailing business serving the NEPA area.",
    url: "https://mikes-auto-detailing-website.vercel.app",
    image: "https://placehold.co/800x500/020617/ef4444?text=Mike's+Auto+Detailing",
    alt: "Mike's Auto Detailing website",
    category: "Auto",
  },
  {
    title: "Velez Property Solutions",
    description: "Professional property services site with service breakdowns, a trust-building about section, and a lead-capture contact form.",
    url: "https://vps-velez-property-solutions.vercel.app",
    image: "https://placehold.co/800x500/020617/10b981?text=Velez+Property+Solutions",
    alt: "Velez Property Solutions website",
    category: "Real Estate",
  },
];
---

<BaseLayout
  title="Featured Websites"
  description="Live websites built by Sam Builds Websites for NEPA contractors, restaurants, shops, and service providers. See real results."
>
  <div class="tech-grid">
    <section class="section page-header text-center">
      <div class="container-narrow">
        <p class="eyebrow">Real Builds. Real Results.</p>
        <h1>Featured Websites</h1>
        <p class="lead">
          Every site you see here is live, fast, and actively driving leads for a real local business.
          Click any card to visit the site.
        </p>
      </div>
    </section>
  </div>

  <FeaturedWebsites
    eyebrow="Client Work"
    heading="Live Sites We've Built"
    subheading="Custom-coded, mobile-first, and built to rank locally."
    sites={sites}
    columns={3}
  />
</BaseLayout>

<style>
  .text-center { text-align: center; }
  .page-header {
    padding-block: clamp(var(--space-12), 10vw, var(--space-16));
  }
  .page-header h1 {
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }
  .lead {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    line-height: var(--leading-snug);
  }
</style>
