---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site.config";
---

<BaseLayout title="Privacy Policy" description={`Privacy policy for ${site.name}.`}>
  <section class="section">
    <div class="container-narrow prose">
      <h1>Privacy Policy</h1>
      <p><em>Last updated: [DATE]</em></p>

      <p>
        This is a placeholder privacy policy. Replace with a real one before launch.
        Free generators: <a href="https://www.termsfeed.com/privacy-policy-generator/">TermsFeed</a>,
        <a href="https://www.privacypolicies.com/">PrivacyPolicies.com</a>.
      </p>

      <h2>Information we collect</h2>
      <p>Describe what info you collect (contact form fields, analytics cookies, etc.).</p>

      <h2>How we use information</h2>
      <p>Explain how data is used and stored.</p>

      <h2>Third-party services</h2>
      <p>List analytics, hosting, email providers, etc.</p>

      <h2>Contact</h2>
      <p>Questions? Email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .prose h1 { color: var(--color-primary); margin-bottom: var(--space-6); }
  .prose h2 { color: var(--color-primary); margin-top: var(--space-8); margin-bottom: var(--space-3); }
  .prose p { margin-bottom: var(--space-4); }
</style>
